# 必填：访问密码（不设置时站点会提示管理员配置后再可用）
PASSWORD=change-me

# Dedicated database on the existing MySQL instance; run migrations with a separate DDL identity.
# Node directly on the host: 127.0.0.1; Docker connecting to host MySQL: host.docker.internal.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=libretv
MYSQL_USER=libretv_app
MYSQL_PASSWORD=change-me
MYSQL_CONNECTION_LIMIT=2
# Optional alternative connection format (takes precedence over MYSQL_*): mysql://user:password@host:3306/libretv
# DATABASE_URL=
ACCOUNT_NAME=家庭账号
# Public HTTPS origin used to validate browser writes behind a reverse proxy.
# APP_ORIGIN=https://your-domain.example

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1
SEARCH_CONCURRENCY=4
SEARCH_MAX_PAGES=5
SEARCH_SOURCE_TIMEOUT_MS=10000

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：调试
DEBUG=false

# 可选：固定使用某个发布镜像版本（默认不设置 = ghcr.io/librespark/libretv:latest，
# 首次部署先 docker compose pull 拉取；本地开发可用 docker compose up -d --build 构建）
# LIBRETV_IMAGE=ghcr.io/librespark/libretv:2.0.1
