      "css": ".ds-tv-controls{padding:24px;background:rgba(0,0,0,.88);color:#fff;font:16px/24px sans-serif;display:flex;flex-direction:column;gap:14px}.ds-tv-controls p{margin:0}.ds-tv-controls small{color:#BCBCC7;font:12px/16px sans-serif}.ds-tv-controls>div{display:flex;gap:14px;padding:8px;overflow:auto}.ds-tv-controls button{flex-shrink:0;padding:10px 16px;border:0;border-radius:999px;background:rgba(73,69,79,.8);color:rgba(230,225,229,.8);font:500 14px/20px sans-serif;letter-spacing:.1px}.ds-tv-controls button:hover,.ds-tv-controls button:focus-visible{background:#E6E1E5;color:#313033;transform:scale(1.1);outline:0}.ds-tv-controls button:active{transform:scale(1)}"
